# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real keys/secrets.

# Get a free key at https://aistudio.google.com/app/apikey
# No credit card required.
GEMINI_API_KEY=your-gemini-key-here

# Create a free project at https://supabase.com, then run
# supabase/schema.sql in its SQL Editor before starting the app —
# sign-in/sign-up will fail without it. Find these three values under
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — never exposed to the browser. Not required for the app
# to run today; it's reserved for durable, cross-instance rate limiting
# via the usage_daily table (see supabase/schema.sql), which isn't
# wired into the API routes yet.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
